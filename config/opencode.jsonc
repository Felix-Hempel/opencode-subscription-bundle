{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///home/opencode/.config/opencode/router/provider-error-normalizer.js",
    "oh-my-openagent@5.1.7",
    "@ex-machina/opencode-anthropic-auth@1.8.6",
    "file:///home/opencode/.config/opencode/router/subscription-router.js"
  ],
  "model": "anthropic/claude-opus-5-5",
  "small_model": "opencode-go/glm-5.3-flash",
  "default_agent": "Sisyphus - ultraworker",
  "enabled_providers": ["anthropic", "openai", "opencode-go"],
  "share": "disabled",
  "autoupdate": false,
  "instructions": ["/home/opencode/.config/opencode/router/orchestration.md"],
  "provider": {
    "anthropic": { "blacklist": ["claude-fable-5", "claude-fable-5-1"], "options": { "timeout": false, "headerTimeout": 60000, "chunkTimeout": 120000 } },
    "openai": { "options": { "timeout": false, "headerTimeout": 60000, "chunkTimeout": 120000 } },
    "opencode-go": { "options": { "timeout": false, "headerTimeout": 45000, "chunkTimeout": 90000 } }
  },
  "tool_output": { "max_lines": 250, "max_bytes": 16000 },
  "compaction": { "auto": true, "prune": true, "tail_turns": 8 }
}
